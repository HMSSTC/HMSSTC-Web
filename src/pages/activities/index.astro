---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingSatellites from "../../components/FloatingSatellites.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allActivities = await getCollection("activities");
const activities = allActivities
  .filter((entry) => !entry.id.endsWith(".en.md"))
  .map((entry) => {
    const enId = entry.id.replace(".md", ".en.md");
    const translatedEntry = allActivities.find((e) => e.id === enId);
    return { ...entry, translatedEntry };
  })
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const allAlbums = await getCollection("gallery");
const albums = allAlbums
  .filter((album) => album.id !== "example-album")
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });
---

<BaseLayout
  title="活動花絮 | 夏漢民太空科技中心"
  pageTitleKey="activitiesPage.pageTitle"
>
  <div class="pt-36 pb-24 bg-white min-h-screen relative overflow-hidden">
    <FloatingSatellites id="activities-list" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <header class="mb-10">
        <h1
          class="text-2xl md:text-4xl sm:text-3xl font-heading font-bold text-gray-900 mb-4"
          data-i18n="activitiesPage.heading"
        >
          活動花絮
        </h1>
        <p class="text-gray-500 text-lg" data-i18n="activitiesPage.description">
          瀏覽中心活動報導與精彩影像
        </p>
      </header>

      <nav class="flex flex-wrap gap-3 mb-16" aria-label="活動內容分類">
        <a href="#reports" class="section-jump bg-tech-blue text-white">
          <span data-i18n="activitiesPage.jumpReports">活動報導</span>
          <span class="count-badge">{activities.length}</span>
        </a>
        <a href="#albums" class="section-jump bg-gray-100 text-gray-700 hover:bg-gray-200">
          <span data-i18n="activitiesPage.jumpAlbums">活動相簿</span>
          <span class="count-badge bg-white/80 text-gray-500">{albums.length}</span>
        </a>
      </nav>

      <section id="reports" class="scroll-mt-28">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">REPORTS</p>
            <h2 data-i18n="activitiesPage.reportsTitle">活動報導</h2>
          </div>
          <p data-i18n="activitiesPage.reportsDescription">掌握中心舉辦與參與的重要活動</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {activities.map((item, index) => (
            <article class="group relative bg-white rounded-lg overflow-hidden shadow-card transition-all duration-300 card-hover border border-gray-100">
              <div class="mission-number text-gray-200">{String(index + 1).padStart(2, "0")}</div>
              <div class="relative h-52 overflow-hidden">
                {item.data.image &&
                  (typeof item.data.image === "string" ? (
                    <img src={item.data.image} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                  ) : (
                    <Image src={item.data.image} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                  ))}
              </div>
              <div class="p-6 pt-8">
                <h3 class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors" data-lang-content="zh-TW">{item.data.title}</h3>
                <h3 class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors" data-lang-content="en" style="display: none;">{item.translatedEntry?.data.title ?? item.data.title}</h3>
                <p class="text-sm text-gray-500 mb-3">
                  <span data-i18n="activitiesPage.datePrefix">公告時間</span>{" "}
                  <span data-lang-content="zh-TW">{item.data.date}</span>
                  <span data-lang-content="en" style="display: none;">{item.translatedEntry?.data.date ?? item.data.date}</span>
                </p>
                <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="zh-TW">{item.data.excerpt}</p>
                <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="en" style="display: none;">{item.translatedEntry?.data.excerpt ?? item.data.excerpt}</p>
                <a href={`/activities/${item.slug}`} class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300">
                  <span data-i18n="activitiesPage.readMore">了解更多</span><span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="albums" class="scroll-mt-28 mt-24 pt-20 border-t border-gray-200">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">PHOTO ALBUMS</p>
            <h2 data-i18n="activitiesPage.albumsTitle">活動相簿</h2>
          </div>
          <p data-i18n="activitiesPage.albumsDescription">珍藏中心活動的每一個精彩瞬間</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {albums.map((album, index) => {
            const photoCount = album.data.folders && album.data.folders.length > 0
              ? album.data.folders.reduce((count, folder) => count + folder.photos.length, 0)
              : album.data.photos.length;
            return (
              <article class="group relative bg-white rounded-lg overflow-hidden shadow-card transition-all duration-300 card-hover border border-gray-100">
                <div class="mission-number text-gray-200">{String(index + 1).padStart(2, "0")}</div>
                <a href={`/gallery/${album.id}`} class="block">
                  <div class="relative h-52 overflow-hidden bg-gradient-to-br from-tech-blue to-tech-blue-light">
                    {album.data.cover ? (
                      <img src={album.data.cover} alt={album.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-white/50">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
                        </svg>
                      </div>
                    )}
                    <div class="absolute bottom-3 right-3 bg-black/60 text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1.5 backdrop-blur-sm">
                      <span>{photoCount}</span><span data-i18n="gallery.photoCount">張照片</span>
                    </div>
                  </div>
                </a>
                <div class="p-6 pt-8">
                  <h3 class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors" data-lang-content="zh-TW">{album.data.title}</h3>
                  <h3 class="text-lg font-heading font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-tech-blue transition-colors" data-lang-content="en" style="display: none;">{album.data.titleEn ?? album.data.title}</h3>
                  <p class="text-sm text-gray-500 mb-3"><span data-i18n="gallery.datePrefix">發布時間</span>{" "}{album.data.date}</p>
                  {(album.data.description || album.data.descriptionEn) && (
                    <>
                      <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="zh-TW">{album.data.description}</p>
                      <p class="text-gray-600 text-sm line-clamp-3 mb-4" data-lang-content="en" style="display: none;">{album.data.descriptionEn ?? album.data.description}</p>
                    </>
                  )}
                  <a href={`/gallery/${album.id}`} class="inline-flex items-center gap-2 text-tech-blue font-medium text-sm hover:gap-3 transition-all duration-300">
                    <span data-i18n="gallery.viewAlbum">瀏覽相簿</span><span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .section-jump { display:inline-flex; align-items:center; gap:.65rem; padding:.75rem 1.15rem; border-radius:.5rem; font-weight:600; transition:all .25s ease; }
  .count-badge { display:inline-flex; align-items:center; justify-content:center; min-width:1.6rem; height:1.6rem; padding:0 .4rem; border-radius:999px; background:rgba(255,255,255,.18); font-size:.75rem; }
  .section-heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:2.5rem; }
  .section-heading h2 { margin-top:.35rem; color:#111827; font-size:clamp(1.65rem,3vw,2.25rem); font-weight:700; }
  .section-heading > p { max-width:30rem; color:#6b7280; }
  .section-eyebrow { color:#1d4ed8; font-family:'Exo',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.18em; }
  @media (max-width:640px) { .section-heading { align-items:start; flex-direction:column; gap:.75rem; } }
</style>
